#!/usr/bin/env bash

set -xe
SECURE=0
PORT=2222
DOCKER_TAG=devcontainer-quick
AUTHORIZED_KEYS=$(pwd)/authorized_keys
if [ ! -e $AUTHORIZED_KEYS ]; then
    AUTHORIZED_KEYS=$HOME/stuff/dev/authorized_keys
fi
while [ $# -gt 0 ]; do
    case "$1" in
        --secure)
            SECURE=1
            shift 1
            ;;
        --port)
            PORT="$2"
            shift 2
            ;;
        --docker-tag)
            DOCKER_TAG="$2"
            shift 2
            ;;
        --authorized-keys)
            AUTHORIZED_KEYS=$(realpath "$2")
            shift 2
            ;;
        --help)
            cat <<EOF
Usage: $(basename "$0") [OPTIONS]

Run the devcontainer image and mount the current workspace into it.

Options:
  --secure                 Do not mount secrets into the container
  --port PORT              Host port forwarded to the container's SSH port
                           (default: 2222)
  --docker-tag TAG         Image tag to run (default: devcontainer-quick)
  --authorized-keys PATH   authorized_keys file to mount
                           (default: ./authorized_keys, falling back to
                           ~/stuff/dev/authorized_keys)
  --help                   Show this help message and exit
EOF
            exit
            ;;
        *)
            echo "Unknown argument: $1. Try --help"
            exit 1
            ;;
    esac
done
case "$PWD/" in
    "$HOME/stuff/dev/"*/*/) exit 1 ;;
    "$HOME/stuff/dev/"*) ;;
    *) exit 1 ;;
esac
if [ ! -e $AUTHORIZED_KEYS ]; then
    exit 1
fi
if [ "$DOCKER_TAG" = "devcontainer-quick" ]; then
    VSCODE_SERVER_DIR_PATH=$HOME/.vscode-server
    if ! docker image inspect devcontainer-quick > /dev/null 2>&1; then
        docker-build \
            --docker-tag devcontainer-quick \
            --system-file "" \
            -e "(@ (suika-chan systems guix-infra) devcontainer-quick-operating-system)"
    fi
else
    if [ "$PWD" = "$HOME/stuff/dev" ]; then
        exit 1
    fi
    VSCODE_SERVER_DIR_PATH=$(pwd)/.vscode-server
fi
WORKSPACE_DIR_GUEST_PATH="/home/app${PWD#"$HOME"}"
mkdir -p ~/.cache/opencode
mkdir -p ~/.config/opencode
mkdir -p ~/.local/share/opencode
mkdir -p ~/.local/state/opencode
mkdir -p $VSCODE_SERVER_DIR_PATH
if [ ! -e ~/.gitconfig ]; then
    touch ~/.gitconfig
fi
if [ "$SECURE" != 1 ]; then
    if [ ! -e ~/.gitconfig.secret ]; then
        touch ~/.gitconfig.secret
    fi
    if [ ! -e ~/.git-credentials ]; then
        touch ~/.git-credentials
    fi
fi
if [ ! -e ~/.config/opencode/cli.json ]; then
    touch ~/.config/opencode/cli.json
fi
if [ ! -e ~/.config/opencode/opencode.jsonc ]; then
    touch ~/.config/opencode/opencode.jsonc
fi
exec docker run \
    -it \
    -v /etc/ssh/ssh_host_ed25519_key:/etc/ssh/ssh_host_ed25519_key:ro \
    -v $AUTHORIZED_KEYS:/home/app/.ssh/authorized_keys:ro \
    -v $HOME/.gitconfig:/home/app/.gitconfig:ro \
    $(if [ "$SECURE" != 1 ]; then echo "-v $HOME/.gitconfig.secret:/home/app/.gitconfig.secret:ro"; fi) \
    $(if [ "$SECURE" != 1 ]; then echo "-v $HOME/.git-credentials:/home/app/.git-credentials:ro"; fi) \
    -v $(realpath ~/.config/opencode/cli.json):$(realpath ~/.config/opencode/cli.json):ro \
    -v $(realpath ~/.config/opencode/opencode.jsonc):$(realpath ~/.config/opencode/opencode.jsonc):ro \
    -v $HOME/.cache/opencode:/home/app/.cache/opencode \
    -v $HOME/.config/opencode:/home/app/.config/opencode \
    -v $HOME/.local/share/opencode:/home/app/.local/share \
    -v $HOME/.local/state/opencode:/home/app/.local/state/opencode \
    -v $VSCODE_SERVER_DIR_PATH:/home/app/.vscode-server \
    -v $PWD:$WORKSPACE_DIR_GUEST_PATH \
    -p $PORT:2222 \
    --rm \
    $DOCKER_TAG

