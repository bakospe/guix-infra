#!/usr/bin/env bash

set -xe
SECURE=0
PORT=2222
DOCKER_TAG=devcontainer-quick
AUTHORIZED_KEYS=$(pwd)/authorized_keys
if [ ! -e $AUTHORIZED_KEYS ]; then
    AUTHORIZED_KEYS=$HOME/stuff/dev/authorized_keys
fi
VSCODE_SERVER=$(pwd)/.vscode-server
if [ ! -e $VSCODE_SERVER ]; then
    VSCODE_SERVER=$HOME/.vscode-server
fi
DEFAULT_EXTRA_SHADOW_MOUNTS=(.vscode-server)
EXTRA_SHADOW_MOUNTS=()
REST_ARGS=()
while [ $# -gt 0 ]; do
    case "$1" in
        --secure)
            SECURE=1
            shift 1
            ;;
        --port)
            PORT="$2"
            shift 2
            ;;
        --docker-tag)
            DOCKER_TAG="$2"
            shift 2
            ;;
        --authorized-keys)
            AUTHORIZED_KEYS=$(realpath "$2")
            shift 2
            ;;
        --vscode-server)
            VSCODE_SERVER=$(realpath "$2")
            shift 2
            ;;
        --shadow)
            DEFAULT_EXTRA_SHADOW_MOUNTS=()
            if [ -n "$2" ]; then
                EXTRA_SHADOW_MOUNTS+=("$2")
            fi
            shift 2
            ;;
        --help)
            cat <<EOF
Usage: $(basename "$0") [OPTIONS]

Run the devcontainer image and mount the current workspace into it.

Options:
  --secure                 Do not mount secrets into the container
  --port PORT              Host port forwarded to the container's SSH port
                           (default: 2222)
  --docker-tag TAG         Image tag to run (default: devcontainer-quick)
  --authorized-keys PATH   authorized_keys file to mount
                           (default: ./authorized_keys, falling back to
                           ~/stuff/dev/authorized_keys)
  --vscode-server PATH     vscode-server directory to mount
                           (default: ./.vscode-server, falling back to
                           ~/.vscode-server)
  --shadow PATH            Shadow-mount PATH instead of the default,
                           may be repeated or empty
  --help                   Show this help message and exit

Extra arguments are passed to docker run.
EOF
            exit
            ;;
        *)
            REST_ARGS+=("$1")
            shift
            ;;
    esac
done
case "$PWD/" in
    "$HOME/stuff/dev/"*/*/) exit 1 ;;
    "$HOME/stuff/dev/"*) ;;
    *) exit 1 ;;
esac
if [ ! -e $AUTHORIZED_KEYS ]; then
    exit 1
fi
if [ "$DOCKER_TAG" = "devcontainer-quick" ]; then
    if ! docker image inspect devcontainer-quick > /dev/null 2>&1; then
        docker-build \
            --docker-tag devcontainer-quick \
            --system-file "" \
            -e "(@ (suika-chan systems guix-infra) devcontainer-quick-operating-system)"
    fi
elif [ "$PWD" = "$HOME/stuff/dev" ]; then
    exit 1
fi
WORKSPACE_DIR_GUEST_PATH="/home/app${PWD#"$HOME"}"
mkdir -p ~/.copilot
mkdir -p ~/.cache/opencode
mkdir -p ~/.config/opencode
mkdir -p ~/.local/share/opencode
mkdir -p ~/.local/state/opencode
mkdir -p $VSCODE_SERVER
if [ ! -e ~/.gitconfig ]; then
    touch ~/.gitconfig
fi
if [ "$SECURE" != 1 ]; then
    if [ ! -e ~/.gitconfig.secret ]; then
        touch ~/.gitconfig.secret
    fi
    if [ ! -e ~/.git-credentials ]; then
        touch ~/.git-credentials
    fi
fi
if [ ! -e ~/.copilot/copilot-instructions.md ]; then
    touch ~/.copilot/copilot-instructions.md
fi
if [ ! -e ~/.config/opencode/cli.json ]; then
    touch ~/.config/opencode/cli.json
fi
if [ ! -e ~/.config/opencode/opencode.jsonc ]; then
    touch ~/.config/opencode/opencode.jsonc
fi
if [ ! -e ~/.config/opencode/AGENTS.md ]; then
    touch ~/.config/opencode/AGENTS.md
fi
SHADOW_MOUNT_CANDS=("${DEFAULT_EXTRA_SHADOW_MOUNTS[@]}" "${EXTRA_SHADOW_MOUNTS[@]}")
if [ "$SECURE" = 1 ] && [ "$PWD" != "$HOME/stuff/dev" ] && [ -e .git ]; then
    readarray -t roots < <(git submodule foreach --recursive --quiet 'printf "%s\n" "$sm_path"')
    for root in . "${roots[@]}"; do
        [ -e "$root/.git" ] || continue
        prefix="${root#./}"
        if [ "$prefix" = "." ]; then
            prefix=""
        fi
        prefix="${prefix:+$prefix/}"
        while IFS= read -r -d "" path; do
            SHADOW_MOUNT_CANDS+=("$prefix$path")
        done < <(git -C "$root" ls-files -z --others --ignored --exclude-standard --directory)
    done
fi
SHADOW_MOUNTS=()
for cand in "${SHADOW_MOUNT_CANDS[@]}"; do
    cand="${cand%/}"
    [ -e "$cand" ] || continue
    cand=$(realpath "$cand")
    [ "${cand#"$PWD"/}" != "$cand" ] || continue
    cand="${cand#"$PWD"/}"
    if [ -d "$cand" ]; then
        SHADOW_MOUNTS+=(--tmpfs "$WORKSPACE_DIR_GUEST_PATH/$cand:size=1")
    else
        SHADOW_MOUNTS+=(-v "/dev/null:$WORKSPACE_DIR_GUEST_PATH/$cand")
    fi
done
exec docker run \
    -it \
    -v /etc/ssh/ssh_host_ed25519_key:/etc/ssh/ssh_host_ed25519_key:ro \
    -v $AUTHORIZED_KEYS:/home/app/.ssh/authorized_keys:ro \
    -v $HOME/.gitconfig:/home/app/.gitconfig:ro \
    $(if [ "$SECURE" != 1 ]; then echo "-v $HOME/.gitconfig.secret:/home/app/.gitconfig.secret:ro"; fi) \
    $(if [ "$SECURE" != 1 ]; then echo "-v $HOME/.git-credentials:/home/app/.git-credentials:ro"; fi) \
    -v $HOME/.config/opencode/cli.json:/home/app/.config/opencode/cli.json:ro \
    -v $HOME/.config/opencode/opencode.jsonc:/home/app/.config/opencode/opencode.jsonc:ro \
    -v $HOME/.config/opencode/AGENTS.md:/home/app/.config/opencode/AGENTS.md:ro \
    -v $HOME/.copilot/copilot-instructions.md:/home/app/.copilot/copilot-instructions.md:ro \
    -v $HOME/.cache/opencode:/home/app/.cache/opencode \
    -v $HOME/.config/opencode:/home/app/.config/opencode \
    -v $HOME/.local/share/opencode:/home/app/.local/share \
    -v $HOME/.local/state/opencode:/home/app/.local/state/opencode \
    -v $VSCODE_SERVER:/home/app/.vscode-server \
    -v $PWD:$WORKSPACE_DIR_GUEST_PATH \
    "${SHADOW_MOUNTS[@]}" \
    -p $PORT:2222 \
    --rm \
    "${REST_ARGS[@]}" \
    $DOCKER_TAG

